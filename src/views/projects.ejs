<%- include('partials/header') %>
    <main>
        <div class="page-header">
            <h1>
                <%= title %>
            </h1>
            <% if (locals.user && locals.user.role_name === 'admin') { %>
                <a href="/new-project" class="btn-primary">+ Add Service Project</a>
            <% } %>
        </div>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach(project=> { %>
                <li class="project-item">
                    <span>
                        <strong class="project-date">
                            <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                                day: 'numeric' }) %>
                        </strong>:
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </span>
                    <span>
                        <i>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </i>
                        <img src="/images/<%= project.logo_filename %>" alt="<%= project.organization_name %> logo">

                    </span>
                </li>
                <% }) %>
        </ul>
    </main>
    <%- include('partials/footer') %>