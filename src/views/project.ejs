<%- include('partials/header') %>
    <main class="project-details-container">
        <h1>
            <%= title %>
        </h1>

        <div class="project-card">
            <p class="project-description">
                <%= project.description %>
            </p>

            <div class="project-meta">
                <p>
                    <strong>Date:</strong> 
                    <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </p>
                <p>
                    <strong>Location:</strong> 
                    <%= project.location %>
                </p>
                <p class="organization-info">
                    <strong>Partner Organization:</strong> 
                    <a href="/organization/<%= project.organization_id %>" class="org-link">
                        <%= project.organization_name %>
                    </a>
                </p>
                <% if (categories && categories.length > 0) { %>
                    <p class="project-tags-info">
                        <strong>Categories:</strong>
                        <% categories.forEach((category, index) => { %>
                            <a href="/category/<%= category.category_id %>" class="category-tag-link">
                                <%= category.name %></a><%= index < categories.length - 1 ? ',' : '' %>
                        <% }) %>
                    </p>
                <% } %>
                <% if (project.logo_filename) { %>
                    <div class="org-logo-container">
                        <img src="/images/<%= project.logo_filename %>" alt="<%= project.organization_name %> logo" class="org-logo">
                    </div>
                <% } %>
            </div>

            <% if (user && user.role_name === 'admin') { %>
            <div class="project-actions" style="margin-top: var(--space-lg); padding-top: var(--space-md); border-top: 1px solid var(--color-border);">
                <a href="/assign-categories/<%= project.project_id %>" class="btn-secondary">Edit Categories</a>
            </div>
            <% } %>
        </div>
    </main>
<%- include('partials/footer') %>
