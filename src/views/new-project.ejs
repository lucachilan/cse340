<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <div class="form-card">
            <form action="/new-project" method="POST" class="org-form">
                <div class="form-group">
                    <label for="title">Project Title</label>
                    <input type="text" id="title" name="title" placeholder="e.g. Community Garden Prep" maxlength="200" required />
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description" rows="4" placeholder="Describe the service project and its goals..." maxlength="1000" required></textarea>
                </div>

                <div class="form-group">
                    <label for="location">Location</label>
                    <input type="text" id="location" name="location" placeholder="e.g. 123 Main St, City" maxlength="255" required />
                </div>

                <div class="form-group">
                    <label for="date">Date</label>
                    <input type="date" id="date" name="date" required />
                </div>

                <div class="form-group">
                    <label for="organizationId">Organization</label>
                    <select id="organizationId" name="organizationId" required>
                        <option value="">Select an organization</option>
                        <% organizations.forEach(org => { %>
                            <option value="<%= org.organization_id %>"><%= org.name %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-actions">
                    <a href="/projects" class="btn-secondary">Cancel</a>
                    <button type="submit" class="btn-primary">Create Project</button>
                </div>
            </form>
        </div>

    </main>
    <%- include('partials/footer') %>
